from scapy.all import sniff, IP, TCP, ICMP
from collections import defaultdict
from datetime import datetime
import subprocess

# -----------------------------
# Configuration
# -----------------------------

PING_THRESHOLD = 20
SCAN_THRESHOLD = 15

ping_counter = defaultdict(int)
port_scan_counter = defaultdict(set)

LOG_FILE = "ids_alerts.log"

AUTO_BLOCK = False  # Change to True to enable automatic blocking


# -----------------------------
# Alert Function
# -----------------------------

def log_alert(message):
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    alert = f"[{timestamp}] ALERT: {message}"

    print(alert)

    with open(LOG_FILE, "a") as f:
        f.write(alert + "\n")


# -----------------------------
# Block Suspicious IP
# -----------------------------

def block_ip(ip):
    if not AUTO_BLOCK:
        return

    try:
        subprocess.run(
            ["sudo", "iptables", "-A", "INPUT", "-s", ip, "-j", "DROP"],
            check=True
        )

        log_alert(f"Blocked IP: {ip}")

    except Exception as e:
        print("Failed to block IP:", e)


# -----------------------------
# Packet Analysis
# -----------------------------

def analyze_packet(packet):

    if not packet.haslayer(IP):
        return

    src_ip = packet[IP].src
    dst_ip = packet[IP].dst

    print(f"\n{src_ip} --> {dst_ip}")

    # ICMP Monitoring
    if packet.haslayer(ICMP):

        ping_counter[src_ip] += 1

        print("Protocol: ICMP")

        if ping_counter[src_ip] > PING_THRESHOLD:

            log_alert(
                f"Possible Ping Flood from {src_ip}"
            )

            block_ip(src_ip)

    # TCP Monitoring
    if packet.haslayer(TCP):

        tcp_layer = packet[TCP]

        dst_port = tcp_layer.dport

        print(f"Protocol: TCP Port {dst_port}")

        port_scan_counter[src_ip].add(dst_port)

        if len(port_scan_counter[src_ip]) > SCAN_THRESHOLD:

            log_alert(
                f"Possible Port Scan from {src_ip}"
            )

            block_ip(src_ip)


# -----------------------------
# Main Program
# -----------------------------

def main():

    print("=" * 60)
    print(" Network Intrusion Detection System (IDS)")
    print("=" * 60)
    print("Monitoring network traffic...")
    print("Press CTRL+C to stop.")
    print("=" * 60)

    sniff(
        prn=analyze_packet,
        store=False
    )


if __name__ == "__main__":
    main()
